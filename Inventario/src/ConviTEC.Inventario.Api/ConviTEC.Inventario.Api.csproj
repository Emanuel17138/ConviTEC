<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Sin usings implícitos: evita System.Linq y colecciones nativas por accidente (RNF06, RNF09). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ConviTEC.Inventario.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConviTEC.Inventario\ConviTEC.Inventario.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConviTEC.Inventario.Tests" />
  </ItemGroup>

</Project>
